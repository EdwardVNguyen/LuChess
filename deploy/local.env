# The settings for the local check in docs/deploy.md only (compose.local.yaml).
# Nothing here is a secret, and none of it belongs in production: a plain
# http:// origin, a cookie that is not Secure, and emails printed to the log.
IMAGE_TAG=local
POSTGRES_PASSWORD=local
JWT_SECRET=local-check-only-not-a-secret-0123456789abcdef
FRONTEND_ORIGIN=http://localhost
COOKIE_SECURE=false
MAILER=console
# compose.local.yaml leaves cloudflared out, but Compose still reads every
# service's settings, and compose.yaml requires this one.
TUNNEL_TOKEN=unused
