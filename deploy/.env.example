# The production settings for compose.yaml. Copy this to .env next to it,
# fill it in, and make it readable by its owner alone:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is ignored by git. Never commit it.

# The commit to run: the full SHA of a commit on main whose images CI has
# published to GHCR. Changing it and running `docker compose up -d` deploys
# that commit, or rolls back to it. `latest` also works, but a SHA says what
# is running.
IMAGE_TAG=

# The database password. Generate one with `openssl rand -hex 32`: it goes
# into a URL as it is, so keep it to letters and digits.
POSTGRES_PASSWORD=

# Signs access tokens. At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# The site's own origin: scheme and host, no path or trailing slash. The web
# image was built with the same value as VITE_API_URL.
FRONTEND_ORIGIN=https://luchess.example.com

# The refresh cookie is Secure unless this is "false". Leave it unset in
# production: visitors reach the site over HTTPS.
# COOKIE_SECURE=

# How emails go out: "smtp" sends them; "console" only prints them to the
# API's log, so never use it here.
MAILER=smtp
# All required with MAILER=smtp. Port 465 uses TLS from the start; any other
# port (usually 587) must offer STARTTLS, or nothing is sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LuChess <no-reply@luchess.example.com>

# The tunnel's token, from Cloudflare's dashboard (Networks > Tunnels, the
# tunnel, then the docker command it shows). Anyone who has it can serve
# their own site as this one.
TUNNEL_TOKEN=

# Nightly backups (backup.sh, docs/deploy.md). Every one is required by
# backup.sh, none by the site itself.
#
# The R2 bucket the dumps go to, and an R2 API token for it with "Object Read
# & Write" on that bucket alone (R2, then Manage API tokens). The account ID
# is on R2's overview page.
R2_ACCOUNT_ID=
R2_BUCKET=luchess-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dumps older than this many days are deleted from the bucket.
BACKUP_KEEP_DAYS=30
# The check's ping URL from healthchecks.io. backup.sh pings it when a backup
# starts, succeeds or fails, and Healthchecks emails you when one fails or
# none arrives in time.
BACKUP_HEALTHCHECK_URL=
