DB_URL=postgres://postgres:postgres@localhost:5433/chessnotes?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173
# Signs access tokens. Required, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
# The refresh cookie is Secure unless this is "false". Browsers treat http://localhost
# as secure, so leave it unset unless yours refuses the cookie (Safari does).
# COOKIE_SECURE=false
# How emails go out: "console" prints them, links and all, to the API's log; "smtp"
# sends them. Required, with no default, so production never prints them by mistake.
MAILER=console
# With MAILER=smtp, all of these are required. Port 465 uses TLS from the start; any
# other port (usually 587) must offer STARTTLS, or nothing is sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=LuChess <no-reply@example.com>
