DB_URL=postgres://postgres:postgres@localhost:5433/chessnotes?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173
# Signs access tokens. Required, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
# The refresh cookie is Secure unless this is "false". Browsers treat http://localhost
# as secure, so leave it unset unless yours refuses the cookie (Safari does).
# COOKIE_SECURE=false
# Rate limits count per client address. Behind Cloudflare every request arrives from
# the proxy, so "true" takes the visitor's address from CF-Connecting-IP instead.
# Safe only when the API can be reached solely through Cloudflare: anyone who can
# reach it directly can forge the header and choose their own address. Leave it
# unset in development.
# TRUST_PROXY_HEADERS=true
